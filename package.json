{
  "name": "url-relation",
  "description": "Determine the relation between two URLs.",
  "version": "1.0.0-alpha15",
  "license": "MIT",
  "author": "Steven Vachon <contact@svachon.com> (https://svachon.com)",
  "repository": "github:stevenvachon/url-relation",
  "type": "module",
  "exports": "./dist/index.js",
  "dependencies": {
    "any-match": "^3.0.1",
    "deep-freeze-strict": "^1.1.1",
    "evaluate-value": "^3.0.0",
    "isurl": "^5.0.0",
    "parse-domain": "^4.1.0"
  },
  "devDependencies": {
    "@types/deep-freeze-strict": "^1.1.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "prettier": "^3.9.6",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "build": "npm run build:spellcheck && npm run build:lint && npm run build:typecheck:supplemental && npm run build:compile",
    "build:compile": "tsc -p tsconfig.build.json",
    "build:lint": "prettier --check '**/*.{config.js,json,md,ts}' '!coverage/**' '!dist/**' '!test/helpers/*.json'",
    "build:spellcheck": "cspell '**/*.{config.js,json,md,ts}' '!coverage/**' '!dist/**' '!node_modules/**' --no-progress",
    "build:typecheck:supplemental": "tsc --project tsconfig.check.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run test:watch -- --reporter=verbose --run",
    "test:watch": "vitest dev --coverage --coverage.include=src/*.ts --coverage.reporter=html --coverage.reporter=lcov --coverage.reporter=text"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "match",
    "uri",
    "url",
    "relation",
    "whatwg"
  ]
}
